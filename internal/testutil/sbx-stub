#!/bin/sh
# Stub of Docker Sandboxes' sbx for integration and end-to-end tests: sandboxes
# are files in $SBX_STUB_DIR/sandboxes (line 1 status, line 2 workspace), and
# `run` behaves like a Claude session that stays until it is terminated, or
# runs the fake claude (SBX_STUB_CLAUDE) that fires hq's injected hooks.
# Workspaces may be Windows paths, as sbx.exe sees them from WSL.
# With SBX_STUB_BOOT set to a path, `run` starts a sandbox that is not
# running only once that file exists, as sbx takes a while to start one
# before the session begins. `create` logs its arguments to creates.log,
# and with SBX_STUB_CREATE_ERR set fails with that error, as sbx does for a
# template or MCP server it cannot find.
set -eu
d=${SBX_STUB_DIR:?SBX_STUB_DIR not set}
mkdir -p "$d/sandboxes"

# put NAME STATUS WORKSPACE writes a sandbox's file whole: written aside,
# then renamed over it, so an `ls` running at the same time reads the old
# file or the new one, never a half-written one (#94).
put() {
    printf '%s\n%s\n' "$2" "$3" >"$d/.put.$$"
    mv -f "$d/.put.$$" "$d/sandboxes/$1"
}
cmd=$1
shift
case $cmd in
ls)
    printf '{"sandboxes":['
    sep=
    for f in "$d"/sandboxes/*; do
        [ -e "$f" ] || continue
        status=$(sed -n 1p "$f")
        ws=$(sed -n 2p "$f" | sed 's/\\/\\\\/g')
        printf '%s{"name":"%s","agent":"claude","status":"%s","workspaces":["%s"]}' "$sep" "$(basename "$f")" "$status" "$ws"
        sep=,
    done
    printf ']}\n'
    ;;
create)
    printf '%s\n' "$*" >>"$d/creates.log"
    if [ -n "${SBX_STUB_CREATE_ERR:-}" ]; then
        printf 'error: %s\n' "$SBX_STUB_CREATE_ERR" >&2
        exit 1
    fi
    ws=
    while [ $# -gt 0 ]; do
        case $1 in
        --template | -t | --static-mcp) shift ;;
        -q | --quiet | claude) ;;
        *) ws=$1 ;;
        esac
        shift
    done
    put "claude-$(basename "$(printf %s "$ws" | tr '\\' /)")" stopped "$ws"
    ;;
run)
    [ "$1" = --name ] || { echo "stub: run needs --name" >&2; exit 1; }
    name=$2
    shift 3 # --name NAME --
    [ -e "$d/sandboxes/$name" ] || { echo "stub: no sandbox $name" >&2; exit 1; }
    ws=$(sed -n 2p "$d/sandboxes/$name")
    if [ "$(sed -n 1p "$d/sandboxes/$name")" != running ]; then
        while [ -n "${SBX_STUB_BOOT:-}" ] && [ ! -e "$SBX_STUB_BOOT" ]; do sleep 0.1; done
        put "$name" running "$ws"
    fi
    printf '%s\n' "$*" >>"$d/runs.log"
    echo $$ >>"$d/pids-$name"
    last=
    for last; do :; done # the prompt, if any; the settings stay in runs.log
    echo "claude in $name: $last"
    [ -z "${SBX_STUB_EXIT:-}" ] || exit "$SBX_STUB_EXIT"
    # With SBX_STUB_CLAUDE, the session is the fake claude firing the hooks.
    [ -z "${SBX_STUB_CLAUDE:-}" ] || exec "$SBX_STUB_CLAUDE" "$@"
    trap 'echo "claude ended"; exit 0' TERM INT HUP
    while :; do sleep 1; done
    ;;
stop)
    put "$1" stopped "$(sed -n 2p "$d/sandboxes/$1")"
    # Stopping ends every session in the sandbox.
    [ ! -e "$d/pids-$1" ] || xargs kill -TERM <"$d/pids-$1" 2>/dev/null || true
    rm -f "$d/pids-$1"
    ;;
rm)
    [ "$1" != --force ] || shift
    rm "$d/sandboxes/$1"
    ;;
exec)
    # Like sbx, exec starts a stopped sandbox; the command runs on the host.
    [ ! -e "$d/sandboxes/$1" ] || put "$1" running "$(sed -n 2p "$d/sandboxes/$1")"
    shift
    exec "$@"
    ;;
*)
    echo "stub: unknown command $cmd" >&2
    exit 1
    ;;
esac
