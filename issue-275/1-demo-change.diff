diff --git a/lib/next_integration_test.go b/lib/next_integration_test.go
new file mode 100644
index 0000000..ad4fa60
--- /dev/null
+++ b/lib/next_integration_test.go
@@ -0,0 +1,22 @@
+//go:build integration
+
+package lib
+
+import (
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestNext(t *testing.T) {
+	if Next(1) != 2 {
+		t.Fatal("Next(1)")
+	}
+	bin := filepath.Join(t.TempDir(), "greet")
+	if out, err := exec.Command("go", "build", "-o", bin, "example.com/demo/cmd/greet").CombinedOutput(); err != nil {
+		t.Fatalf("go build: %v\n%s", err, out)
+	}
+	if out, err := exec.Command(bin).Output(); err != nil || string(out) != "hello\n" {
+		t.Fatalf("greet: %q, %v", out, err)
+	}
+}
