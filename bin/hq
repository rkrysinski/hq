#!/usr/bin/env bash
# agents - manage Claude Code sessions (running in Docker Sandboxes) as tmux windows.
# With iTerm2 tmux integration, every window shows up as a native tab.
#
# Usage:
#   agents                            attach (or create) the session in iTerm2 tmux mode
#   agents new NAME [DIR] [PROMPT]    new tab running Claude in DIR's sandbox (DIR defaults to $PWD)
#   agents ls                         list tabs and what runs in them
#   agents go NAME                    jump to a tab (by name or number); attaches if detached
#   agents kill NAME                  close one tab (ends that Claude session)
#   agents stop                       kill the whole tmux session (all agents)
#
# Env:
#   AGENTS_SESSION   tmux session name (default: agents)

set -euo pipefail

SESSION="${AGENTS_SESSION:-agents}"

die() { echo "agents: $*" >&2; exit 1; }
has_session() { tmux has-session -t "$SESSION" 2>/dev/null; }
ensure_session() { has_session || tmux new-session -d -s "$SESSION" -n home -c "$HOME"; }
has_window() { tmux list-windows -t "$SESSION" -F '#W' | grep -qx "$1"; }

# One sandbox per repo, named after the repo folder (same convention sbx uses)
sandbox_name() { echo "claude-$(basename "$1")"; }

cmd_attach() {
  ensure_session
  [ -z "${TMUX:-}" ] || die "already inside tmux"
  exec tmux -CC attach -t "$SESSION"
}

cmd_new() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: agents new NAME [DIR] [PROMPT]"
  local dir; dir="$(cd "${2:-$PWD}" && pwd)" || die "no such directory: ${2:-}"
  local prompt="${3:-}"
  local sbx; sbx="$(sandbox_name "$dir")"

  has_session && has_window "$name" && die "tab '$name' already exists"

  # Reuse the repo's sandbox if it exists, otherwise create it
  local run
  if sbx ls 2>/dev/null | grep -qw "$sbx"; then
    run="sbx run $(printf %q "$sbx")"
  else
    run="sbx run --name $(printf %q "$sbx") claude $(printf %q "$dir")"
  fi
  [ -z "$prompt" ] || run="$run -- $(printf %q "$prompt")"

  # Keep the tab open after the session ends, so the output can be reviewed
  local cmd="$run; echo; echo '[session ended - Ctrl-D to close tab]'; exec \$SHELL -l"
  if has_session; then
    tmux new-window -d -t "$SESSION" -n "$name" -c "$dir" "$cmd"
  else
    # First agent becomes the session's first window - no placeholder tab
    tmux new-session -d -s "$SESSION" -n "$name" -c "$dir" "$cmd"
  fi
  echo "started '$name' in sandbox $sbx"
}

cmd_ls() {
  has_session || die "no '$SESSION' session running"
  # The tab's shell runs "sbx run ...; exec $SHELL", so tmux reports the shell as the
  # current command. Look for a live sbx child of the pane's shell instead.
  tmux list-windows -t "$SESSION" -F '#{window_index} #W #{pane_pid}' |
  while read -r idx name pid; do
    if pgrep -P "$pid" -f 'sbx' >/dev/null 2>&1; then state="running"; else state="ended"; fi
    printf '%s  %-20s [%s]\n' "$idx" "$name" "$state"
  done
}

cmd_go() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: agents go NAME"
  has_session || die "no '$SESSION' session running"
  tmux select-window -t "$SESSION:$name" 2>/dev/null || die "no tab '$name'"
  # Nobody attached: attach now, the selected window opens in front
  if [ -z "$(tmux list-clients -t "$SESSION" 2>/dev/null)" ]; then
    [ -z "${TMUX:-}" ] || die "already inside tmux"
    exec tmux -CC attach -t "$SESSION"
  fi
  # iTerm2 tmux integration ignores tmux's window selection - select the tab in iTerm2 itself
  local wname; wname="$(tmux display-message -p -t "$SESSION:$name" '#W')"
  osascript - "$wname" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  set wanted to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        if name of current session of t is wanted then
          tell w to select t
          activate
          return
        end if
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

cmd_kill() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: agents kill NAME"
  has_session && has_window "$name" || die "no tab '$name'"
  tmux kill-window -t "$SESSION:$name"
}

cmd_stop() {
  has_session || die "no '$SESSION' session running"
  read -r -p "Kill all agent tabs in '$SESSION'? [y/N] " ans
  [ "$ans" = "y" ] || exit 0
  tmux kill-session -t "$SESSION"
}

case "${1:-attach}" in
  attach)   shift || true; cmd_attach ;;
  new)      shift; cmd_new "$@" ;;
  ls)       cmd_ls ;;
  go)       shift; cmd_go "$@" ;;
  kill)     shift; cmd_kill "$@" ;;
  stop)     cmd_stop ;;
  -h|--help|help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        die "unknown command '$1' (try: agents help)" ;;
esac
